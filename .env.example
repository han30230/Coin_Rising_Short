# Binance (필수 — sh 계정)
BINANCE_API_KEY=your_api_key
BINANCE_SECRET=your_secret
# 또는 BINANCE_API_KEY_SH / BINANCE_SECRET_SH

# 추가 계정 (멀티 계정 실행 시)
# BINANCE_API_KEY_JK=
# BINANCE_SECRET_JK=
# BINANCE_API_KEY_JK_2=
# BINANCE_SECRET_JK_2=

BINANCE_ENV=mainnet
LEVERAGE=5
FORCE_HEDGE=false

# 전략 (Bybit 봇과 동일 기본값)
GAINER_THRESHOLD_PCT=25
QUALIFIED_WATCH_TOP_N=30
MIN_VOLUME_USDT=100000
USE_REENTRY=false
MAX_CONCURRENT_POSITIONS=50

# 유니버스 필터 (기본 OFF)
FILTER_UPBIT_LISTED=false
FILTER_SPOT_COEXIST=false
FILTER_FUTURES_LISTING_AGE=false

# SuperTrend (4h / ATR 4 / Factor 7)
USE_SUPERTREND_ENTRY=true
USE_SUPERTREND_EXIT=true
SUPERTREND_INTERVAL=4h
SUPERTREND_ATR_PERIOD=4
SUPERTREND_FACTOR=7
SUPERTREND_SOURCE=hl2

# 시가총액 필터 (선택, CoinMarketCap)
# USE_MCAP_FILTER=false
# CMC_API_KEY=
# MIN_MARKET_CAP_USD=1000000
# MCAP_FAIL_OPEN=true
# MCAP_CACHE_TTL_SEC=900

# Mcap/FDV 필터 (선택, CoinGecko)
FILTER_MCAP_FDV=false
MIN_MCAP_FDV_RATIO=0.4
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
